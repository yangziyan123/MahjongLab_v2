# Copy this file to .env. Never commit a real API key.
MAHJONGLAB_REVIEW_ASSISTANT_PROVIDER=deepseek
MAHJONGLAB_REVIEW_ASSISTANT_API_KEY=

# DeepSeek defaults; omit these lines to use the application defaults.
MAHJONGLAB_REVIEW_ASSISTANT_BASE_URL=https://api.deepseek.com
MAHJONGLAB_REVIEW_ASSISTANT_MODEL=deepseek-v4-flash
MAHJONGLAB_REVIEW_ASSISTANT_THINKING=false
MAHJONGLAB_REVIEW_ASSISTANT_TIMEOUT_SECONDS=45
MAHJONGLAB_REVIEW_ASSISTANT_MAX_OUTPUT_TOKENS=900
